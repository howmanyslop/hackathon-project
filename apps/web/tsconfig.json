{
	"compilerOptions": {
		"tsBuildInfoFile": "./node_modules/.tmp/web.tsbuildinfo",
		"target": "ES2022",
		"jsx": "react-jsx",
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"module": "ESNext",
		"moduleResolution": "bundler",
		"paths": {
			"$agent/*": ["./src/agent/*"],
			"$archive/*": ["./src/archive/*"],
			"$components/*": ["./src/components/*"],
			"$db/*": ["./src/db/*"],
			"$features/*": ["./src/features/*"],
			"$hooks/*": ["./src/hooks/*"],
			"$integrations/*": ["./src/integrations/*"],
			"$lib/*": ["./src/lib/*"],
			"$llm/*": ["./src/llm/*"],
			"$mcp/*": ["./src/mcp/*"],
			"$orpc/*": ["./src/orpc/*"],
			"$search/*": ["./src/search/*"],
			"$server/*": ["./src/server/*"]
		},
		"types": ["vite/client"],
		"allowImportingTsExtensions": true,
		"strict": true,
		"noFallthroughCasesInSwitch": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"noEmit": true,
		"verbatimModuleSyntax": true,
		"skipLibCheck": true,
		"noUncheckedSideEffectImports": true
	},
	"include": ["**/*.ts", "**/*.tsx", ".storybook/**/*.ts", ".storybook/**/*.tsx"]
}
