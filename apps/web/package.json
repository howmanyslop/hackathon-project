{
	"name": "@web-template/web",
	"version": "0.0.0",
	"private": true,
	"description": "The app.",
	"type": "module",
	"imports": {
		"#/*": "./src/*"
	},
	"scripts": {
		"build": "vp build",
		"build-storybook": "storybook build",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "cf d1 migrations apply \"$CLOUDFLARE_DATABASE_ID\" --dir drizzle --local --persist-to .cloudflare/state",
		"db:migrate:remote": "cf d1 migrations apply \"$CLOUDFLARE_DATABASE_ID\" --dir drizzle",
		"db:pull": "drizzle-kit pull",
		"db:push": "drizzle-kit push",
		"db:studio": "drizzle-kit studio",
		"deploy": "turbo run build type-check && cf deploy --prebuilt --mode production",
		"dev": "vp dev --port 3000",
		"generate-routes": "vp build",
		"preview": "vp preview",
		"start": "node .output/server/index.mjs",
		"storybook": "storybook dev -p 6006",
		"test": "vp test run --config vitest.unit.config.ts",
		"test:browser": "vp test run --project storybook",
		"type-check": "tsrs --noEmit",
		"type-check:agent": "tsrs --noEmit --pretty false"
	},
	"dependencies": {
		"@base-ui/react": "catalog:frontend",
		"@orpc/client": "catalog:orpc",
		"@orpc/server": "catalog:orpc",
		"@orpc/tanstack-query": "catalog:web",
		"@tailwindcss/vite": "catalog:vite",
		"@tanstack/react-devtools": "catalog:tanstack",
		"@tanstack/react-query": "catalog:tanstack",
		"@tanstack/react-query-devtools": "catalog:tanstack",
		"@tanstack/react-router": "catalog:tanstack",
		"@tanstack/react-router-devtools": "catalog:tanstack",
		"@tanstack/react-router-ssr-query": "catalog:tanstack",
		"@tanstack/react-start": "catalog:tanstack",
		"class-variance-authority": "catalog:frontend",
		"cn": "catalog:frontend",
		"drizzle-kit": "catalog:database",
		"drizzle-orm": "catalog:database",
		"react": "catalog:frontend",
		"react-dom": "catalog:frontend",
		"tailwindcss": "catalog:frontend",
		"tw-animate-css": "catalog:frontend",
		"zod": "catalog:web"
	},
	"devDependencies": {
		"@chromatic-com/storybook": "catalog:storybook",
		"@rolldown/plugin-babel": "catalog:web",
		"@storybook/addon-a11y": "catalog:storybook",
		"@storybook/addon-docs": "catalog:storybook",
		"@storybook/addon-mcp": "catalog:storybook",
		"@storybook/addon-vitest": "catalog:storybook",
		"@storybook/tanstack-react": "catalog:storybook",
		"@tailwindcss/typography": "catalog:web",
		"@tanstack/devtools-vite": "catalog:tanstack",
		"@types/node": "catalog:node26",
		"@types/react": "catalog:types",
		"@types/react-dom": "catalog:types",
		"@vitejs/plugin-react": "catalog:vite",
		"@vitest/browser-playwright": "catalog:tooling",
		"@vitest/coverage-v8": "catalog:test",
		"babel-plugin-react-compiler": "catalog:web",
		"cf": "catalog:tooling",
		"nitro": "catalog:vite",
		"playwright": "catalog:tooling",
		"storybook": "catalog:storybook",
		"tsx": "catalog:web",
		"typescript": "catalog:tooling",
		"vite": "catalog:tooling",
		"vite-plus": "catalog:tooling",
		"vitest": "catalog:tooling"
	}
}
