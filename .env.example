# Copy to .env (mise loads it). Never commit real values.

# Postgres for `node --run dev`, `db:migrate`, and `db:studio`. Development uses
# the cluster's database: `mise run k8s:db` forwards it to localhost:5432 and
# prints the URL to use here, password included.
DATABASE_URL=

# Elastic Cloud Serverless (semantic search). Optional: leave both unset and the
# app runs without search. From the project's page in https://cloud.elastic.co:
# the Elasticsearch endpoint, and an API key from "Manage API keys".
# `mise run k8s:deploy` copies both into the cluster's `web-elastic` Secret.
ELASTICSEARCH_URL=
ELASTICSEARCH_API_KEY=

# The rest are optional; blank means the default in parentheses.
# Kibana, for the Agent Builder agent (the Elasticsearch URL with .es. -> .kb.).
KIBANA_URL=
# Index for sessions' passages and question-and-answer pairs (asked-archive).
# A laptop sharing the cluster's Elastic project can use its own, like
# asked-archive-dev-yourname, so its session numbers don't clash.
ELASTICSEARCH_ARCHIVE_INDEX=
# Index the hourly "What people are asking" workflow writes to (asked-digest).
ELASTICSEARCH_DIGEST_INDEX=
# Elastic inference endpoint tried first to split talks into pairs
# (.anthropic-claude-5-sonnet-chat_completion). It answers 403 for this
# project today, so OpenRouter below does the split.
ELASTIC_LLM_INFERENCE_ID=
# Agent Builder agent behind the Ask box (asked-and-answered).
ELASTIC_AGENT_ID=
# Most the Ask box may spend on the paid agent, in US dollars (20); 0 turns it off.
ASK_BUDGET_USD=
# Cost logged per question when the agent reports no token usage, in dollars (0.10).
ASK_COST_ESTIMATE_USD=

# OpenRouter, the fallback when Elastic's model fails. Leave the key blank to
# go without. `mise run k8s:deploy` copies both into the `web-llm` Secret.
OPENROUTER_API_KEY=
# Model ID (anthropic/claude-haiku-5.5).
OPENROUTER_MODEL=

# The shared code presenters type on /record. `k8s:deploy` makes a random one
# for the cluster; set your own here for `node --run dev`. `mise run seed`
# falls back to the cluster's code when this is blank.
PRESENTER_CODE=

# Cloudflare Tunnel token, from the tunnel's page in the Cloudflare dashboard.
# Without it `k8s:deploy` starts a temporary trycloudflare.com address.
CLOUDFLARE_TUNNEL_TOKEN=

# Dash0 (observability), for `mise run dash0:install`. Only needed by whoever
# installs the operator. From https://app.dash0.com/goto/settings/endpoints:
# the OTLP via gRPC endpoint (ingress.….dash0.com:4317) and the API endpoint
# (https://api.….dash0.com). The token is from Settings > Auth Tokens.
DASH0_ENDPOINT=
DASH0_API_ENDPOINT=
DASH0_AUTH_TOKEN=
