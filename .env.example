# Copy to .env (mise loads it). Never commit real values.

# Postgres for `node --run dev`, `db:migrate`, and `db:studio`. This matches the
# local container in apps/web/README.md, which needs no password and only
# listens on this machine. `mise run k8s:db` prints the cluster's URL instead.
DATABASE_URL=postgres://postgres@localhost:5432/web
