# Copy to .env (mise loads it). Never commit real values.

# Postgres for `node --run dev`, `db:migrate`, and `db:studio`. This matches the
# local container in apps/web/README.md. To use the cluster's database, run
# `mise run k8s:db` and use the password from the `web-postgres` Secret.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/web
